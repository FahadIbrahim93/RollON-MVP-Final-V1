# Production build: talk to the real reference API (same-origin /api on Vercel).
# The serverless function (api/rollon.js) handles /api/* — see vercel.json rewrite.
VITE_USE_REMOTE_API=true
# Same-origin by default — the Vercel rewrite maps /api/* → api/rollon.js.
# Override with the absolute URL only if hosting the API elsewhere.
# VITE_API_BASE_URL=/api
